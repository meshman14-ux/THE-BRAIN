# Copy this file to .env.local for local dev, and add the same
# three variables in Vercel → Project → Settings → Environment Variables.

# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From console.anthropic.com — used ONLY by the server-side Ledger route (Campaign 4)
ANTHROPIC_API_KEY=sk-ant-...
